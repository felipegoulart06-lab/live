{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.8.0",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/assets/:path*", "destination": "/public/assets/:path*" },
    { "source": "/robots.txt", "destination": "/public/robots.txt" },
    { "source": "/(.*)", "destination": "/api/index.php?__path=$1" }
  ]
}
