{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.8.0",
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/assets/(.*)", "dest": "/public/assets/$1" },
    { "src": "/robots.txt", "dest": "/public/robots.txt" },
    { "src": "/favicon.ico", "dest": "/public/assets/images/favicon.ico" },
    { "src": "/apple-touch-icon.png", "dest": "/public/assets/images/apple-touch-icon.png" },
    { "src": "/apple-touch-icon-precomposed.png", "dest": "/public/assets/images/apple-touch-icon.png" },
    { "src": "/p/([^/]+)", "dest": "/api/index.php?__path=$1" },
    { "src": "/(.*)", "dest": "/api/index.php?__path=$1" }
  ]
}
