APP_NAME="CinquentaConto"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_KEY=

APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_CURRENCY=BRL

# Sem DATABASE_URL o site usa SQLite local (criado e populado com dados de demonstração no primeiro acesso).
DB_PATH=storage/cinquentaconto.sqlite
# Produção (Supabase): Project Settings > Database > Connection string (URI, pooler porta 6543).
DATABASE_URL=

SESSION_NAME=cc_session
SESSION_LIFETIME=120
SESSION_SECURE=false

# Uploads. Sem SUPABASE_URL os arquivos ficam em public/uploads e storage/private.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLIC_BUCKET=public-media
SUPABASE_PRIVATE_BUCKET=private-files
UPLOAD_IMAGE_MAX_MB=5
UPLOAD_FILE_MAX_MB=10

# Contas operadoras (criadas no banco se ainda não existirem).
# SEED_ADMIN_EMAIL=admin@cinquentaconto.com.br
# SEED_ADMIN_PASSWORD=CinquentaAdmin!234
# SEED_CREATOR_EMAIL=anunciante@cinquentaconto.com.br
# SEED_CREATOR_PASSWORD=CinquentaCriador!234
# SEED_COMPANY_EMAIL=empresa@cinquentaconto.com.br
# SEED_COMPANY_PASSWORD=CinquentaEmpresa!234

MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=nao-responda@localhost
MAIL_FROM_NAME="${APP_NAME}"

RATE_LIMIT_LOGIN=8
RATE_LIMIT_WINDOW=300
