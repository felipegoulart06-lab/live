APP_NAME="Nexo"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_KEY=

APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_CURRENCY=BRL

DB_PATH=storage/nexo.sqlite

GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SESSION_NAME=nexo_session
SESSION_LIFETIME=120
SESSION_SECURE=false

MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=nao-responda@localhost
MAIL_FROM_NAME="${APP_NAME}"

UPLOAD_MAX_MB=20
RATE_LIMIT_LOGIN=8
RATE_LIMIT_WINDOW=300
