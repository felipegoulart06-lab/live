{
    "name": "cinquentaconto/marketplace",
    "description": "CinquentaConto — horas de vídeo para empresas",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/functions.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "migrate": "php database/migrate.php",
        "seed": "php database/seed.php",
        "install-data": "php database/install.php"
    }
}
